# Supabase project settings. Copy the actual values from the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Local database migrations use the Session Pooler URI (port 5432).
SUPABASE_DB_MIGRATION_URL=postgresql://postgres.your-project-ref:YOUR_DATABASE_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
LOVABLE_DB_MIGRATION_URL=postgresql://postgres.your-project-ref:YOUR_DATABASE_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Server-only key. Never expose or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cron secret for automated tasks
CRON_SECRET=your-random-cron-secret-token

# Cloudinary API credentials (server-only; never use VITE_ prefixes).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional admin bootstrap. Use a dedicated address and a password with 8+ characters.
# Keep the real values only in the ignored local .env file.
MARKETNET_ADMIN_EMAIL=admin@example.com
MARKETNET_ADMIN_PASSWORD=
MARKETNET_ADMIN_NAME=Administrateur MarketNet
MARKETNET_SITE_URL=http://localhost:8080

# Passerelle de paiement SasPay (serveur uniquement — sk_test_... en dev)
SASPAY_ENV=test
SASPAY_SECRET_KEY=sk_test_your_saspay_secret_key
SASPAY_WEBHOOK_SECRET=whsec_your_saspay_webhook_secret
